Realistic Fill Model
Models slippage, commissions, and bid-ask spreads
"""

from dataclasses import dataclass
from typing import Literal


@dataclass
class FillCost:
    """Breakdown of fill costs"""
    entry_price: float
    bid_ask_cost: float
    slippage_cost: float
    commission_cost: float
    total_entry_cost: float


class FillModel:
    def __init__(self,
                 slippage_bps: float = 1.0,
                 commission_bps: float = 0.1,
                 bid_ask_spread_pips: float = 0.5):
        self.slippage_bps = slippage_bps
        self.commission_bps = commission_bps
        self.bid_ask_spread_pips = bid_ask_spread_pips
    
    def calculate_fill_price(self,
                           signal_price: float,
                           direction: Literal["long", "short"] = "long",
                           asset: str = "XAUUSD") -> float:
        fill_price = signal_price
        
        if direction == "long":
            fill_price += self.bid_ask_spread_pips
        else:
            fill_price -= self.bid_ask_spread_pips
        
        slippage_amount = fill_price * (self.slippage_bps / 10000)
        if direction == "long":
            fill_price += slippage_amount
        else:
            fill_price -= slippage_amount
        
        return round(fill_price, 5)
    
    def calculate_commission(self,
                           position_size: float,
                           fill_price: float) -> float:
        notional_value = position_size * fill_price
        commission = notional_value * (self.commission_bps / 10000)
        return round(commission, 2)
    
    def get_full_entry_cost(self,
                          signal_price: float,
                          position_size: float,
                          direction: Literal["long", "short"] = "long") -> FillCost:
        fill_price = self.calculate_fill_price(signal_price, direction)
        commission = self.calculate_commission(position_size, fill_price)
        
        bid_ask_cost = self.bid_ask_spread_pips * position_size
        slippage_cost = fill_price * (self.slippage_bps / 10000) * position_size
        
        total_cost = bid_ask_cost + slippage_cost + commission
        
        return FillCost(
            entry_price=fill_price,
            bid_ask_cost=round(bid_ask_cost, 2),
            slippage_cost=round(slippage_cost, 2),
            commission_cost=commission,
            total_entry_cost=round(total_cost, 2)
        )
    
    def calculate_exit_price(self,
                           signal_price: float,
                           direction: Literal["long", "short"] = "long") -> float:
        if direction == "long":
            exit_price = signal_price - self.bid_ask_spread_pips
        else:
            exit_price = signal_price + self.bid_ask_spread_pips
        
        slippage = exit_price * (self.slippage_bps / 10000)
        if direction == "long":
            exit_price -= slippage
        else:
            exit_price += slippage
        
        return round(exit_price, 5)
`

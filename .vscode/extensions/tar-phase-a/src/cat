Parameter Stability Analyzer
Detects overfitting by tracking if optimal parameters change across walk-forward windows
"""

from dataclasses import dataclass
from typing import List, Dict, Any
import statistics
import json


@dataclass
class ParameterChange:
    """Track parameter changes across windows"""
    param_name: str
    values: List[float]
    mean: float
    min: float
    max: float
    range: float
    std: float
    change_pct: float


class ParameterStabilityAnalyzer:
    def __init__(self, walkforward_results: List[Dict[str, Any]]):
        self.results = walkforward_results
        self.param_changes = {}
    
    def analyze(self) -> Dict[str, Any]:
        """Analyze parameter stability"""
        if not self.results:
            return {"error": "No walk-forward results provided"}
        
        param_names = list(self.results[0]["optimal_params"].keys())
        
        for param_name in param_names:
            values = [r["optimal_params"][param_name] for r in self.results]
            
            mean_val = statistics.mean(values)
            min_val = min(values)
            max_val = max(values)
            range_val = max_val - min_val
            std_val = statistics.stdev(values) if len(values) > 1 else 0
            
            if mean_val != 0:
                change_pct = (range_val / mean_val) * 100
            else:
                change_pct = 0
            
            self.param_changes[param_name] = ParameterChange(
                param_name=param_name,
                values=values,
                mean=mean_val,
                min=min_val,
                max=max_val,
                range=range_val,
                std=std_val,
                change_pct=change_pct
            )
        
        return self.get_summary()
    
    def get_summary(self) -> Dict[str, Any]:
        """Get analysis summary"""
        overall_stability = self.stability_score()
        
        summary = {
            "overall_stability_score": overall_stability,
            "interpretation": self._interpret_score(overall_stability),
            "parameters": {}
        }
        
        for param_name, change in self.param_changes.items():
            summary["parameters"][param_name] = {
                "values": change.values,
                "mean": round(change.mean, 2),
                "min": round(change.min, 2),
                "max": round(change.max, 2),
                "range": round(change.range, 2),
                "std": round(change.std, 2),
                "change_pct": round(change.change_pct, 2),
                "stability": "stable" if change.change_pct < 10 else "unstable"
            }
        
        return summary
    
    def stability_score(self) -> float:
        """Calculate overall stability score (0-1)"""
        if not self.param_changes:
            return 0.0
        
        scores = []
        for change in self.param_changes.values():
            score = max(0, 1 - (change.change_pct / 50))
            scores.append(score)
        
        overall = statistics.mean(scores)
        return round(overall, 3)
    
    def _interpret_score(self, score: float) -> str:
        """Interpret stability score"""
        if score >= 0.9:
            return "Very Stable - Parameters consistent across windows (EXCELLENT)"
        elif score >= 0.7:
            return "Stable - Minor parameter variations (GOOD)"
        elif score >= 0.5:
            return "Moderate - Some parameter drift (CAUTION)"
        elif score >= 0.3:
            return "Unstable - Significant parameter changes (WARNING)"
        else:
            return "Very Unstable - High overfitting risk (REJECT)"
    
    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary for logging"""
        return self.get_summary()
    
    def to_json(self) -> str:
        """Convert to JSON string"""
        return json.dumps(self.to_dict(), indent=2)
`

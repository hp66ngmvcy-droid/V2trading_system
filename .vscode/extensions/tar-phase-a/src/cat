Learning Engine
Systematically records and discovers patterns from backtesting
"""

import json
from pathlib import Path
from datetime import datetime
from typing import Any, Dict, List, Optional
from dataclasses import dataclass, asdict


@dataclass
class Lesson:
    """Represents a single lesson learned"""
    timestamp: str
    category: str
    lesson_text: str
    confidence: float
    evidence: Dict[str, Any]
    source_system: str = "tar"


class LearningEngine:
    def __init__(self, memory_dir: str = "memory"):
        self.memory_dir = Path(memory_dir)
        self.memory_dir.mkdir(exist_ok=True)
        
        self.lessons_file = self.memory_dir / "lessons_learned.jsonl"
        self.patterns_file = self.memory_dir / "cross_system_patterns.json"
    
    def record_lesson(self,
                     category: str,
                     lesson_text: str,
                     confidence: float = 0.5,
                     evidence: Dict[str, Any] = None) -> bool:
        try:
            lesson = Lesson(
                timestamp=datetime.now().isoformat(),
                category=category,
                lesson_text=lesson_text,
                confidence=confidence,
                evidence=evidence or {}
            )
            
            with open(self.lessons_file, "a") as f:
                f.write(json.dumps(asdict(lesson)) + "\\n")
            
            return True
        except Exception as e:
            print(f"[ERROR] Failed to record lesson: {e}")
            return False
    
    def get_lessons_by_category(self, category: str) -> List[Lesson]:
        if not self.lessons_file.exists():
            return []
        
        lessons = []
        with open(self.lessons_file, "r") as f:
            for line in f:
                lesson_dict = json.loads(line)
                if lesson_dict["category"] == category:
                    lessons.append(Lesson(**lesson_dict))
        
        return lessons
    
    def discover_patterns(self) -> Dict[str, Any]:
        if not self.lessons_file.exists():
            return {}
        
        all_lessons = {}
        with open(self.lessons_file, "r") as f:
            for line in f:
                lesson_dict = json.loads(line)
                category = lesson_dict["category"]
                
                if category not in all_lessons:
                    all_lessons[category] = []
                all_lessons[category].append(lesson_dict)
        
        insights = {}
        for category, lessons in all_lessons.items():
            high_confidence = [
                l for l in lessons
                if l["confidence"] >= 0.7
            ]
            
            insights[category] = {
                "total_lessons": len(lessons),
                "high_confidence_lessons": len(high_confidence),
                "avg_confidence": round(
                    sum(l["confidence"] for l in lessons) / len(lessons),
                    2
                ),
                "top_lessons": [
                    l["lesson_text"] for l in high_confidence[:3]
                ]
            }
        
        self._save_patterns(insights)
        
        return insights
    
    def _save_patterns(self, patterns: Dict[str, Any]):
        with open(self.patterns_file, "w") as f:
            json.dump(patterns, f, indent=2)
    
    def get_high_confidence_lessons(self, min_confidence: float = 0.7) -> List[Lesson]:
        if not self.lessons_file.exists():
            return []
        
        lessons = []
        with open(self.lessons_file, "r") as f:
            for line in f:
                lesson_dict = json.loads(line)
                if lesson_dict["confidence"] >= min_confidence:
                    lessons.append(Lesson(**lesson_dict))
        
        return lessons
    
    def get_summary_report(self) -> str:
        patterns = self.discover_patterns()
        
        report = ["=== TAR Learning Summary ===\\n"]
        
        for category, stats in patterns.items():
            report.append(f"\\n{category.upper()}")
            report.append(f"  Total lessons: {stats['total_lessons']}")
            report.append(f"  High confidence: {stats['high_confidence_lessons']}")
            report.append(f"  Average confidence: {stats['avg_confidence']}")
            report.append(f"  Top insights:")
            for i, lesson in enumerate(stats['top_lessons'], 1):
                report.append(f"    {i}. {lesson}")
        
        return "\\n".join(report)
`

export class PhaseAInstaller {
  private currentStepIndex = 0;
  private workspaceRoot: string;
  private completedSteps: Set<number> = new Set();

  constructor(workspaceRoot: string) {
    this.workspaceRoot = workspaceRoot;
  }

  async getCurrentStep(): Promise<InstallStep | null> {
    for (let i = this.currentStepIndex; i < STEPS.length; i++) {
      const step = STEPS[i];
      const filePath = path.join(this.workspaceRoot, step.filePath);
      
      if (!fs.existsSync(filePath)) {
        return step;
      }
      
      this.completedSteps.add(step.id);
    }
    
    return null;
  }

  async showDiff(step: InstallStep): Promise<void> {
    const filePath = path.join(this.workspaceRoot, step.filePath);
    const existingContent = fs.existsSync(filePath) 
      ? fs.readFileSync(filePath, 'utf-8') 
      : '';
    
    const diffResult = diffLines(existingContent, step.content);
    
    const diffPanel = vscode.window.createWebviewPanel(
      'tarPhaseDiff',
      `Diff: ${step.name}`,
      vscode.ViewColumn.Beside,
      {}
    );
    
    let htmlContent = `
      <style>
        body { font-family: monospace; padding: 20px; }
        .added { background-color: #d4edda; color: #155724; }
        .removed { background-color: #f8d7da; color: #721c24; }
        .unchanged { background-color: #f8f9fa; }
        pre { padding: 10px; margin: 5px 0; }
        h2 { color: #333; }
      </style>
      <h2>${step.name}</h2>
      <p>${step.description}</p>
      <h3>File: ${step.filePath}</h3>
      <div>
    `;
    
    diffResult.forEach(part => {
      const value = part.value.replace(/</g, '&lt;').replace(/>/g, '&gt;');
      if (part.added) {
        htmlContent += `<pre class="added">+ ${value}</pre>`;
      } else if (part.removed) {
        htmlContent += `<pre class="removed">- ${value}</pre>`;
      } else {
        htmlContent += `<pre class="unchanged">  ${value}</pre>`;
      }
    });
    
    htmlContent += '</div>';
    diffPanel.webview.html = htmlContent;
  }

  async applyStep(step: InstallStep): Promise<boolean> {
    try {
      const filePath = path.join(this.workspaceRoot, step.filePath);
      const dirPath = path.dirname(filePath);
      
      // Create directories if needed
      if (!fs.existsSync(dirPath)) {
        fs.mkdirSync(dirPath, { recursive: true });
      }
      
      // Write file
      fs.writeFileSync(filePath, step.content, 'utf-8');
      
      // Mark as completed
      this.completedSteps.add(step.id);
      this.currentStepIndex = step.id;
      
      return true;
    } catch (error) {
      vscode.window.showErrorMessage(`Failed to apply step: ${error}`);
      return false;
    }
  }

  async verifyStep(step: InstallStep): Promise<boolean> {
    try {
      const filePath = path.join(this.workspaceRoot, step.filePath);
      return fs.existsSync(filePath);
    } catch {
      return false;
    }
  }

  getProgress(): { completed: number; total: number } {
    return {
      completed: this.completedSteps.size,
      total: STEPS.length
    };
  }

  getAllSteps(): InstallStep[] {
    return STEPS;
  }
}

export function activate(context: vscode.ExtensionContext) {
  let installer: PhaseAInstaller | null = null;
  let statusBar: vscode.StatusBarItem | null = null;

  const startCommand = vscode.commands.registerCommand('tar-phase-a.start', async () => {
    const workspaceFolder = vscode.workspace.workspaceFolders?.[0];
    if (!workspaceFolder) {
      vscode.window.showErrorMessage('No workspace folder open');
      return;
    }

    installer = new PhaseAInstaller(workspaceFolder.uri.fsPath);
    
    // Create status bar
    statusBar = vscode.window.createStatusBarItem(vscode.StatusBarAlignment.Left);
    statusBar.text = '$(loading) TAR Phase A: Starting...';
    statusBar.show();

    // Show welcome message
    const response = await vscode.window.showInformationMessage(
      '🚀 TAR Phase A Installer\n\nThis will install 4 patterns to strengthen your backtest engine.',
      'Start Installation',
      'Learn More'
    );

    if (response === 'Learn More') {
      vscode.env.openExternal(vscode.Uri.parse('https://github.com/your-repo'));
    }

    if (response === 'Start Installation') {
      showNextStep(installer, statusBar);
    }
  });

  async function showNextStep(installer: PhaseAInstaller, statusBar: vscode.StatusBarItem) {
    const step = await installer.getCurrentStep();
    
    if (!step) {
      statusBar.text = '✅ Phase A Installation Complete!';
      vscode.window.showInformationMessage('✅ Phase A installation complete! All patterns installed successfully.');
      return;
    }

    const progress = installer.getProgress();
    statusBar.text = `📦 Phase A: ${progress.completed}/${progress.total} - ${step.name}`;

    const choice = await vscode.window.showInformationMessage(
      `Step ${step.id}/${STEPS.length}: ${step.name}\n\n${step.description}`,
      'Review Diff',
      'Apply & Continue',
      'Skip',
      'Cancel'
    );

    if (choice === 'Review Diff') {
      await installer.showDiff(step);
      const applyChoice = await vscode.window.showInformationMessage(
        'Ready to apply this change?',
        'Apply',
        'Cancel'
      );
      
      if (applyChoice === 'Apply') {
        const success = await installer.applyStep(step);
        if (success) {
          vscode.window.showInformationMessage(`✅ ${step.name} installed successfully!`);
          showNextStep(installer, statusBar);
        }
      }
    } else if (choice === 'Apply & Continue') {
      const success = await installer.applyStep(step);
      if (success) {
        vscode.window.showInformationMessage(`✅ ${step.name} installed!`);
        showNextStep(installer, statusBar);
      }
    } else if (choice === 'Skip') {
      showNextStep(installer, statusBar);
    }
  }

  context.subscriptions.push(startCommand);
}

export function deactivate() {}

{
  "name": "tar-phase-a-installer",
  "displayName": "TAR Phase A Installer",
  "description": "Interactive Phase A installation helper for V2trading system",
  "version": "1.0.0",
  "publisher": "tar-system",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other",
    "Installation",
    "Developer Tools"
  ],
  "activationEvents": [
    "onCommand:tar-phase-a.start",
    "onView:tarPhaseAPanel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tar-phase-a.start",
        "title": "TAR: Start Phase A Installation",
        "category": "TAR Phase A"
      },
      {
        "command": "tar-phase-a.nextStep",
        "title": "Next Step",
        "category": "TAR Phase A"
      },
      {
        "command": "tar-phase-a.applyChange",
        "title": "Apply Change",
        "category": "TAR Phase A"
      },
      {
        "command": "tar-phase-a.reviewDiff",
        "title": "Review Diff",
        "category": "TAR Phase A"
      },
      {
        "command": "tar-phase-a.skipStep",
        "title": "Skip Step",
        "category": "TAR Phase A"
      }
    ],
    "views": {
      "tarPhaseAExplorer": [
        {
          "id": "tarPhaseAPanel",
          "name": "Phase A Installer"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tarPhaseAExplorer",
          "title": "TAR Phase A",
          "icon": "media/tar-icon.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tar-phase-a.nextStep",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tar-phase-a.start",
          "when": "view == tarPhaseAPanel",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "@types/node": "^16.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "typescript": "^4.7.0"
  },
  "dependencies": {
    "yaml": "^2.0.0",
    "diff": "^5.0.0"
  }
}

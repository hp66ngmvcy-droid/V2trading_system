{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "human_outcome_record.json",
  "title": "Human Outcome Record",
  "description": "One record in data/outcomes/brief_outcomes.jsonl",
  "type": "object",
  "required": [
    "brief_date",
    "symbol",
    "side",
    "result",
    "hit_target",
    "hit_stop",
    "entry_actual",
    "exit_price",
    "logged_at"
  ],
  "additionalProperties": false,
  "properties": {
    "brief_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "symbol": {
      "type": "string",
      "enum": ["XAUUSD", "BTCUSD"]
    },
    "side": {
      "type": "string",
      "enum": ["BUY", "SELL"]
    },
    "result": {
      "type": "string",
      "enum": ["TP", "SL", "AMBIGUOUS", "NO_SIGNAL", "PENDING"]
    },
    "hit_target": {
      "type": ["boolean", "null"]
    },
    "hit_stop": {
      "type": ["boolean", "null"]
    },
    "entry_actual": {
      "type": ["number", "null"]
    },
    "exit_price": {
      "type": ["number", "null"]
    },
    "logged_at": {
      "type": "string",
      "description": "UTC datetime ISO 8601"
    },
    "exit_utc": {
      "type": ["string", "null"]
    },
    "bars_held": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "brief_confidence": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "note": {
      "type": "string"
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OutcomeEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "recorded_at",
    "manifest_id",
    "decision_id",
    "trade_id",
    "entry_fill_id",
    "exit_fill_id",
    "state",
    "exit_reason",
    "observed_from",
    "observed_to",
    "target_touched",
    "stop_touched",
    "observed_target_first",
    "assumed_exit",
    "net_pnl",
    "net_r",
    "metric_basis",
    "probability_label"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "record_type": {"type": "string", "const": "OUTCOME_EVENT"},
    "record_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "manifest_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "trade_id": {"type": ["string", "null"]},
    "entry_fill_id": {"type": ["string", "null"]},
    "exit_fill_id": {"type": ["string", "null"]},
    "state": {
      "type": "string",
      "enum": ["OPEN", "RESOLVED", "EXPIRED", "CENSORED", "AMBIGUOUS"]
    },
    "exit_reason": {"type": ["string", "null"]},
    "observed_from": {"type": ["string", "null"], "format": "date-time"},
    "observed_to": {"type": ["string", "null"], "format": "date-time"},
    "target_touched": {"type": ["boolean", "null"]},
    "stop_touched": {"type": ["boolean", "null"]},
    "observed_target_first": {"type": ["boolean", "null"]},
    "assumed_exit": {"type": ["string", "null"], "enum": ["STOP_FIRST", "TARGET_FIRST", null]},
    "net_pnl": {"type": ["number", "null"]},
    "net_r": {"type": ["number", "null"]},
    "metric_basis": {"type": ["string", "null"]},
    "probability_label": {"type": ["integer", "null"], "enum": [0, 1, null]},
    "mfe": {"type": "number"},
    "mae": {"type": "number"},
    "bars_held": {"type": "integer", "minimum": 0}
  }
}

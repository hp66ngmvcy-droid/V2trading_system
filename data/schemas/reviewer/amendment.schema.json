{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Amendment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "recorded_at",
    "supersedes_record_id",
    "reason_code",
    "evidence_hash",
    "replacement_record_id"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "record_type": {"type": "string", "const": "AMENDMENT"},
    "record_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "supersedes_record_id": {"type": "string", "minLength": 1},
    "reason_code": {"type": "string", "minLength": 1},
    "evidence_hash": {"type": "string", "minLength": 1},
    "replacement_record_id": {"type": "string", "minLength": 1},
    "review_note": {"type": "string", "maxLength": 2000}
  }
}

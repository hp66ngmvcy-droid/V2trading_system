{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InputManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "recorded_at",
    "experiment_id",
    "mode",
    "availability_class",
    "brief_hash",
    "data_hash",
    "feature_version",
    "strategy",
    "strategy_version",
    "strategy_parameters",
    "config_hash",
    "broker_profile_hash",
    "symbol",
    "timeframe",
    "instrument",
    "issued_at",
    "received_at",
    "verified_available_at",
    "availability_evidence",
    "data_start",
    "data_end",
    "policy"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "record_type": {"type": "string", "const": "INPUT_MANIFEST"},
    "record_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "experiment_id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["SYNTHETIC", "HISTORICAL_REPLAY", "PROSPECTIVE_PAPER"]},
    "availability_class": {"type": "string", "enum": ["SYNTHETIC", "VERIFIED_PROSPECTIVE", "RETROSPECTIVE", "UNKNOWN"]},
    "brief_hash": {"type": "string", "minLength": 1},
    "data_hash": {"type": "string", "minLength": 1},
    "feature_version": {"type": "string", "minLength": 1},
    "strategy": {"type": "string", "minLength": 1},
    "strategy_version": {"type": "string", "minLength": 1},
    "strategy_parameters": {"type": "object"},
    "config_hash": {"type": "string", "minLength": 1},
    "broker_profile_hash": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "timeframe": {"type": "string", "minLength": 1},
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["venue", "kind", "quote_currency", "account_currency", "contract_size", "tick_size", "lot_step"],
      "properties": {
        "venue": {"type": "string"},
        "kind": {"type": "string"},
        "quote_currency": {"type": "string"},
        "account_currency": {"type": "string"},
        "contract_size": {"type": "number"},
        "tick_size": {"type": "number"},
        "lot_step": {"type": "number"}
      }
    },
    "issued_at": {"type": ["string", "null"], "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "verified_available_at": {"type": ["string", "null"], "format": "date-time"},
    "availability_evidence": {"type": ["string", "null"]},
    "data_start": {"type": "string", "format": "date-time"},
    "data_end": {"type": "string", "format": "date-time"},
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "price_basis", "entry"],
      "properties": {
        "version": {"type": "string"},
        "price_basis": {"type": "string"},
        "entry": {"type": "string"}
      }
    },
    "source_label": {"type": "string"},
    "source_url": {"type": "string"},
    "notes": {"type": "string", "maxLength": 2000}
  }
}

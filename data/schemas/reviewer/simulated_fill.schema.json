{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SimulatedFill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "recorded_at",
    "manifest_id",
    "decision_id",
    "trade_id",
    "fill_role",
    "sequence",
    "symbol",
    "side",
    "filled_at",
    "timing_basis",
    "reference_price",
    "fill_price",
    "quantity_lots",
    "contract_size",
    "embedded_spread_amount",
    "embedded_slippage_amount",
    "commission_amount",
    "swap_amount",
    "account_currency",
    "cost_model_version",
    "initial_risk_amount"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "record_type": {"type": "string", "const": "SIMULATED_FILL"},
    "record_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "manifest_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "trade_id": {"type": "string", "minLength": 1},
    "fill_role": {"type": "string", "enum": ["ENTRY", "EXIT"]},
    "sequence": {"type": "integer", "minimum": 0},
    "symbol": {"type": "string", "minLength": 1},
    "side": {"type": "string", "enum": ["BUY", "SELL"]},
    "filled_at": {"type": ["string", "null"], "format": "date-time"},
    "timing_basis": {"type": "string", "enum": ["BAR_OPEN", "BAR_INTERVAL", "BAR_CLOSE"]},
    "reference_price": {"type": "number"},
    "fill_price": {"type": "number"},
    "quantity_lots": {"type": "number", "exclusiveMinimum": 0},
    "contract_size": {"type": "number", "exclusiveMinimum": 0},
    "embedded_spread_amount": {"type": "number", "minimum": 0},
    "embedded_slippage_amount": {"type": "number", "minimum": 0},
    "commission_amount": {"type": "number", "minimum": 0},
    "swap_amount": {"type": "number", "minimum": 0},
    "account_currency": {"type": "string", "minLength": 1},
    "cost_model_version": {"type": "string", "minLength": 1},
    "initial_risk_amount": {"type": "number"},
    "source_bid": {"type": "number"},
    "source_ask": {"type": "number"},
    "source_bid_at": {"type": "string", "format": "date-time"},
    "source_ask_at": {"type": "string", "format": "date-time"}
  }
}

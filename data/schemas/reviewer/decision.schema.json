{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "recorded_at",
    "manifest_id",
    "brief_hash",
    "symbol",
    "strategy_version",
    "bar_index",
    "bar_open_at",
    "decision_at",
    "action",
    "side",
    "reason_code",
    "proposed_entry",
    "stop_loss",
    "target_1",
    "target_2",
    "analyst_confidence",
    "probability",
    "forecast_event",
    "horizon_bars",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "record_type": {"type": "string", "const": "DECISION"},
    "record_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "manifest_id": {"type": "string", "minLength": 1},
    "brief_hash": {"type": ["string", "null"]},
    "symbol": {"type": "string", "minLength": 1},
    "strategy_version": {"type": "string", "minLength": 1},
    "bar_index": {"type": "integer", "minimum": 0},
    "bar_open_at": {"type": "string", "format": "date-time"},
    "decision_at": {"type": "string", "format": "date-time"},
    "action": {"type": "string", "enum": ["CANDIDATE", "WAIT", "REJECTED"]},
    "side": {"type": ["string", "null"], "enum": ["BUY", "SELL", null]},
    "reason_code": {"type": "string", "minLength": 1},
    "proposed_entry": {"type": ["number", "null"]},
    "stop_loss": {"type": ["number", "null"]},
    "target_1": {"type": ["number", "null"]},
    "target_2": {"type": ["number", "null"]},
    "analyst_confidence": {"type": ["number", "null"]},
    "probability": {"type": ["number", "null"]},
    "forecast_event": {"type": ["string", "null"]},
    "horizon_bars": {"type": ["integer", "null"], "minimum": 1},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "diagnostics": {"type": "object"}
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "brief_levels_schema.json",
  "title": "Daily Brief Levels",
  "description": "Validates data/daily_briefs/*_levels.json files",
  "type": "object",
  "required": ["issued_at", "date", "source", "macro"],
  "additionalProperties": true,
  "properties": {
    "issued_at": {
      "type": "string",
      "description": "ISO 8601 datetime string"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "string"
    },
    "macro": {
      "type": "object",
      "required": ["note"],
      "additionalProperties": true,
      "properties": {
        "note": {
          "type": "string"
        },
        "event_gate": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "XAUUSD": { "$ref": "#/definitions/symbolBlockOrNull" },
    "BTCUSD": { "$ref": "#/definitions/symbolBlockOrNull" }
  },
  "anyOf": [
    { "required": ["XAUUSD"] },
    { "required": ["BTCUSD"] }
  ],
  "definitions": {
    "symbolBlockOrNull": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/definitions/symbolBlock" }
      ]
    },
    "symbolBlock": {
      "type": "object",
      "required": [
        "daily_bias",
        "key_levels",
        "top_scenario",
        "top_scenario_entry",
        "top_scenario_targets",
        "top_scenario_invalidation"
      ],
      "additionalProperties": true,
      "properties": {
        "daily_bias": {
          "type": "string",
          "enum": ["BUY", "SELL", "NEUTRAL"]
        },
        "key_levels": {
          "type": "object",
          "additionalProperties": true
        },
        "top_scenario": {
          "type": "string"
        },
        "top_scenario_entry": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "top_scenario_targets": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1
        },
        "top_scenario_invalidation": {
          "type": "number"
        },
        "current_price": {
          "type": ["number", "null"]
        },
        "buy_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "sell_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    }
  }
}
